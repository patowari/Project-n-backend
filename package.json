{
  "name": "project-n-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Project N API: NestJS modular monolith + workers on PostgreSQL (RLS) and Redis",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "schema:build": "node scripts/build-schema.mjs",
    "build": "node scripts/build-schema.mjs && prisma generate && nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch --env-file .env",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.cjs",
    "migrate:dev": "prisma migrate dev",
    "seed": "nest build && node --env-file-if-exists=.env dist/seed.js",
    "openapi:export": "nest build && node dist/openapi-export.js openapi.json",
    "client:generate": "npm run openapi:export && openapi-typescript openapi.json -o packages/api-client/src/schema.d.ts",
    "test": "node scripts/test-runner.mjs",
    "test:unit": "jest --config jest.unit.config.js",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "verify:openapi": "node scripts/verify-openapi.mjs",
    "docs:generate": "node scripts/gen-api-doc.mjs && node scripts/gen-schema-doc.mjs",
    "loadtest": "node scripts/load/run.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "~6.19.3",
    "@types/multer": "^2.3.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prisma": "~6.19.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "autocannon": "^8.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.9.1",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
