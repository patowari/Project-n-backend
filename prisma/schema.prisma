model Plan {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String   @unique
  name               String
  aiMonthlyBudgetUsd Decimal  @default(0) @db.Decimal(10, 2) @map("ai_monthly_budget_usd")
  maxUsers           Int? @map("max_users")
  createdAt          DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  workspaces         Workspace[]
  @@map("plans")
}

model Workspace {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  shortName String          @default("") @map("short_name")
  type      WorkspaceType
  status    WorkspaceStatus @default(active)
  planId    String?         @db.Uuid @map("plan_id")
  timeZone  String          @default("Asia/Dhaka") @map("time_zone")
  logoUrl   String? @map("logo_url")
  createdAt DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime        @updatedAt @db.Timestamptz(6) @map("updated_at")

  plan        Plan?              @relation(fields: [planId], references: [id])
  settings    WorkspaceSettings?
  faculties   Faculty[]
  departments Department[]
  memberships Membership[]
  invites     Invite[]
  projects    Project[]
  @@map("workspaces")
}

model WorkspaceSettings {
  workspaceId                  String   @id @db.Uuid @map("workspace_id")
  newSupervisorsCanApprove     Boolean  @default(false) @map("new_supervisors_can_approve")
  supervisorsCanCreateProjects Boolean  @default(true) @map("supervisors_can_create_projects")
  aiEnabled                    Boolean  @default(true) @map("ai_enabled")
  /// 0 pauses AI for the workspace. New workspaces start with a small budget.
  aiMonthlyBudgetUsd           Decimal  @default(5) @db.Decimal(10, 2) @map("ai_monthly_budget_usd")
  allowedFileTypes             String[] @default(["pdf", "docx", "pptx", "xlsx", "zip", "png", "jpg", "txt"]) @map("allowed_file_types")
  maxFileMb                    Int      @default(50) @map("max_file_mb")
  maxFilesPerSubmission        Int      @default(10) @map("max_files_per_submission")
  atRiskAfterDays              Int      @default(14) @map("at_risk_after_days")
  awaitingReviewAfterDays      Int      @default(3) @map("awaiting_review_after_days")
  escalateOverdueAfterDays     Int      @default(3) @map("escalate_overdue_after_days")
  defaultSubmissionMode        SubmissionMode @default(leader_only) @map("default_submission_mode")
  defaultUnlockRule            UnlockRule     @default(on_submit) @map("default_unlock_rule")
  term                         Json     @default("{}")
  updatedAt                    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@map("workspace_settings")
}

