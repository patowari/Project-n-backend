  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/* ------------------------------------------------------------------ */
/* Integrations, jobs, idempotency                                     */
/* ------------------------------------------------------------------ */

model GoogleDriveConnection {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @unique @db.Uuid @map("user_id")
  googleEmail     String @map("google_email")
  /// AES-256-GCM: iv(12) | tag(16) | ciphertext. Never leaves the server.
  refreshTokenEnc Bytes @map("refresh_token_enc")
  keyId           String @map("key_id")
  status          DriveStatus @default(connected)
  rootFolderName  String      @default("Project N") @map("root_folder_name")
  rootFolderId    String? @map("root_folder_id")
  error           String?
  connectedAt     DateTime    @default(now()) @db.Timestamptz(6) @map("connected_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("google_drive_connections")
}

/// Durable job queue (transactional outbox). Claimed with FOR UPDATE SKIP LOCKED.
model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        String
  payload     Json      @default("{}")
  workspaceId String?   @db.Uuid @map("workspace_id")
  runAt       DateTime  @default(now()) @db.Timestamptz(6) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  status      JobStatus @default(queued)
  lockedAt    DateTime? @db.Timestamptz(6) @map("locked_at")
  lockedBy    String? @map("locked_by")
  lastError   String? @map("last_error")
  /// Optional: enqueueing the same dedupeKey twice is a no-op.
  dedupeKey   String?   @unique @map("dedupe_key")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  finishedAt  DateTime? @db.Timestamptz(6) @map("finished_at")

  @@index([status, runAt])
  @@index([kind, status])
  @@map("jobs")
}

model IdempotencyKey {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @db.Uuid @map("user_id")
  key            String
  method         String
  path           String
  requestHash    String @map("request_hash")
  state          IdempotencyState @default(in_progress)
  responseStatus Int? @map("response_status")
  responseBody   Json? @map("response_body")
  createdAt      DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  expiresAt      DateTime         @db.Timestamptz(6) @map("expires_at")

  @@unique([userId, key, method, path])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
