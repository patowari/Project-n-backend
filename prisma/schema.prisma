/// Append-only (the app role has INSERT and SELECT only, migration 0002).
model ActivityLog {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String             @db.Uuid @map("workspace_id")
  occurredAt  DateTime           @default(now()) @db.Timestamptz(6) @map("occurred_at")
  facultyId   String?            @db.Uuid @map("faculty_id")
  departmentId String?           @db.Uuid @map("department_id")
  projectId   String?            @db.Uuid @map("project_id")
  phaseId     String?            @db.Uuid @map("phase_id")
  actorId     String?            @db.Uuid @map("actor_id")
  /// Snapshots, so the log stays readable after renames or removals.
  actorName   String @map("actor_name")
  actingRole  String @map("acting_role")
  category    ActivityCategory
  action      String
  targetType  String? @map("target_type")
  targetId    String?            @db.Uuid @map("target_id")
  targetLabel String             @default("") @map("target_label")
  before      String?
  after       String?
  reason      String?
  isOverride  Boolean            @default(false) @map("is_override")
  visibility  ActivityVisibility @default(all)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([projectId, occurredAt(sort: Desc)])
  @@index([workspaceId, facultyId, occurredAt(sort: Desc)])
  @@index([workspaceId, departmentId, occurredAt(sort: Desc)])
  @@map("activity_log")
}

