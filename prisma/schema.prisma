model Faculty {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@map("faculties")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid @map("workspace_id")
  facultyId   String   @db.Uuid @map("faculty_id")
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  faculty     Faculty   @relation(fields: [workspaceId, facultyId], references: [workspaceId, id], onDelete: Restrict)
  memberships Membership[]
  projects    Project[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, facultyId, name])
  @@index([workspaceId, facultyId])
  @@map("departments")
}

model Membership {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String           @db.Uuid @map("workspace_id")
  userId       String           @db.Uuid @map("user_id")
  status       MembershipStatus @default(active)
  /// Approval permission set by the Institution Admin (architecture 5.4)
  canApprove   Boolean          @default(false) @map("can_approve")
  departmentId String?          @db.Uuid @map("department_id")
  studentCode  String? @map("student_code")
  joinedAt     DateTime         @default(now()) @db.Timestamptz(6) @map("joined_at")
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6) @map("updated_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: Restrict)
  roles        MembershipRole[]
  projectLinks ProjectMember[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, departmentId])
  @@map("memberships")
}

model MembershipRole {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String        @db.Uuid @map("workspace_id")
  membershipId String        @db.Uuid @map("membership_id")
  role         WorkspaceRole
  scopeType    ScopeType? @map("scope_type")
  /// Faculty id (dean) or department id (head). Null for workspace-wide roles.
  scopeId      String?       @db.Uuid @map("scope_id")
  createdAt    DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")

  membership   Membership    @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, membershipId])
  @@index([workspaceId, role, scopeId])
  @@map("membership_roles")
}

model Invite {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String        @db.Uuid @map("workspace_id")
  email        String
  name         String        @default("")
  role         WorkspaceRole
  scopeType    ScopeType? @map("scope_type")
  scopeId      String?       @db.Uuid @map("scope_id")
  departmentId String?       @db.Uuid @map("department_id")
  studentCode  String? @map("student_code")
  canApprove   Boolean? @map("can_approve")
  tokenHash    String        @unique @map("token_hash")
  status       InviteStatus  @default(pending)
  invitedById  String        @db.Uuid @map("invited_by_id")
  expiresAt    DateTime      @db.Timestamptz(6) @map("expires_at")
  acceptedAt   DateTime?     @db.Timestamptz(6) @map("accepted_at")
  createdAt    DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, email, status])
  @@map("invites")
}

/* ------------------------------------------------------------------ */
/* Projects                                                            */
/* ------------------------------------------------------------------ */

model Project {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String         @db.Uuid @map("workspace_id")
  title                 String
  description           String         @default("")
  departmentId          String?        @db.Uuid @map("department_id")
  status                ProjectStatus  @default(active)
  health                ProjectHealth  @default(on_track)
  healthReason          String? @map("health_reason")
  healthUpdatedAt       DateTime?      @db.Timestamptz(6) @map("health_updated_at")
  unlockRule            UnlockRule     @default(on_submit) @map("unlock_rule")
  submissionMode        SubmissionMode @default(leader_only) @map("submission_mode")
  aiStudentFeedback     Boolean        @default(true) @map("ai_student_feedback")
  aiSupervisorSummary   Boolean        @default(true) @map("ai_supervisor_summary")
  startDate             DateTime       @db.Date @map("start_date")
  /// Set by succession when the Lead leaves and nobody can take over.
  needsSupervisor       Boolean        @default(false) @map("needs_supervisor")
  driveFolderId         String? @map("drive_folder_id")
  driveFolderUrl        String? @map("drive_folder_url")
  /// Optimistic-lock token for edits (If-Match).
  version               Int            @default(1)
  createdById           String         @db.Uuid @map("created_by_id")
  createdAt             DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt             DateTime?      @db.Timestamptz(6) @map("deleted_at")

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department  Department?    @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: Restrict)
  members     ProjectMember[]
  phases      Phase[]
  submissions Submission[]
  comments    Comment[]
  timeLogs    TimeLog[]
  overrides   Override[]
  revocations ApprovalRevocation[]
  extensions  ExtensionRequest[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, health])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, createdById])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("projects")
}

model ProjectMember {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @db.Uuid @map("workspace_id")
  projectId   String      @db.Uuid @map("project_id")
  userId      String      @db.Uuid @map("user_id")
  role        ProjectRole
  isGroupLeader Boolean   @default(false) @map("is_group_leader")
  isSuccessor Boolean     @default(false) @map("is_successor")
  joinedAt    DateTime    @default(now()) @db.Timestamptz(6) @map("joined_at")
  leftAt      DateTime?   @db.Timestamptz(6) @map("left_at")
  leftReason  String? @map("left_reason")

  project     Project     @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  /// The person must hold a membership in the SAME workspace.
  membership  Membership  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId])
  @@index([workspaceId, userId])
  /// Workers (BYPASSRLS) look members up by project / person without a workspace filter.
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model PhaseTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  items       PhaseTemplateItem[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@map("phase_templates")
}

model PhaseTemplateItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String @db.Uuid @map("workspace_id")
  templateId   String @db.Uuid @map("template_id")
  position     Int
  name         String
  durationDays Int @map("duration_days")

  template     PhaseTemplate @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("phase_template_items")
}

model Phase {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String      @db.Uuid @map("workspace_id")
  projectId     String      @db.Uuid @map("project_id")
  position      Int
  name          String
  description   String      @default("")
  status        PhaseStatus @default(locked)
  dueDate       DateTime?   @db.Date @map("due_date")
  latestVersion Int         @default(0) @map("latest_version")
  approvedAt    DateTime?   @db.Timestamptz(6) @map("approved_at")
  approvedById  String?     @db.Uuid @map("approved_by_id")
  approvedByRole String? @map("approved_by_role")
  createdAt     DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6) @map("updated_at")

  project       Project     @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  requirements  PhaseRequirement[]
  resources     PhaseResource[]
  draftFiles    DraftFile[]
  submissions   Submission[]
  extensions    ExtensionRequest[]

  @@unique([workspaceId, id])
  @@unique([projectId, position])
  @@index([workspaceId, dueDate])
  @@map("phases")
}

model PhaseRequirement {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String  @db.Uuid @map("workspace_id")
  phaseId     String  @db.Uuid @map("phase_id")
  name        String
  optional    Boolean @default(false)
  position    Int     @default(0)

  phase       Phase   @relation(fields: [workspaceId, phaseId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, phaseId])
  @@map("phase_requirements")
}

model PhaseResource {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid @map("workspace_id")
  phaseId     String   @db.Uuid @map("phase_id")
  kind        String
  name        String
  url         String
  sizeKb      Int? @map("size_kb")
  addedById   String   @db.Uuid @map("added_by_id")
  addedAt     DateTime @default(now()) @db.Timestamptz(6) @map("added_at")

  phase       Phase    @relation(fields: [workspaceId, phaseId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, phaseId])
  @@map("phase_resources")
}

/// Files the group has gathered for the NEXT version of a phase.
model DraftFile {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @db.Uuid @map("workspace_id")
  projectId     String    @db.Uuid @map("project_id")
  phaseId       String    @db.Uuid @map("phase_id")
  requirementId String?   @db.Uuid @map("requirement_id")
  name          String
  mimeType      String @map("mime_type")
  sizeBytes     BigInt @map("size_bytes")
  driveFileId   String @map("drive_file_id")
  driveUrl      String @map("drive_url")
  md5           String?
  uploadedById  String    @db.Uuid @map("uploaded_by_id")
  uploadedAt    DateTime  @default(now()) @db.Timestamptz(6) @map("uploaded_at")

  phase         Phase     @relation(fields: [workspaceId, phaseId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([phaseId, driveFileId])
  @@index([workspaceId, phaseId])
  @@index([projectId, uploadedAt(sort: Desc)])
  @@map("draft_files")
}

/// Immutable once created. A new version is a new row.
model Submission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @db.Uuid @map("workspace_id")
  projectId      String           @db.Uuid @map("project_id")
  phaseId        String           @db.Uuid @map("phase_id")
  version        Int
  status         SubmissionStatus @default(submitted)
  submittedById  String           @db.Uuid @map("submitted_by_id")
  submittedAt    DateTime         @default(now()) @db.Timestamptz(6) @map("submitted_at")
  note           String           @default("")
  idempotencyKey String? @map("idempotency_key")
  aiStatus       AiStatus         @default(disabled) @map("ai_status")
  aiReleased     Boolean          @default(false) @map("ai_released")

  project        Project          @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  phase          Phase            @relation(fields: [workspaceId, phaseId], references: [workspaceId, id], onDelete: Cascade)
  files          SubmissionFile[]
  reviews        Review[]
  aiReview       AiReview?

  @@unique([workspaceId, id])
  @@unique([phaseId, version])
  @@unique([workspaceId, submittedById, idempotencyKey])
  @@index([workspaceId, projectId, submittedAt(sort: Desc)])
  @@index([workspaceId, status, submittedAt])
  @@index([projectId, submittedAt(sort: Desc)])
  @@map("submissions")
}

model SubmissionFile {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String     @db.Uuid @map("workspace_id")
  /// Denormalised so the RLS policy needs no nested policy lookup.
  projectId     String     @db.Uuid @map("project_id")
  submissionId  String     @db.Uuid @map("submission_id")
  requirementId String?    @db.Uuid @map("requirement_id")
  name          String
  mimeType      String @map("mime_type")
  sizeBytes     BigInt @map("size_bytes")
  driveFileId   String @map("drive_file_id")
  driveUrl      String @map("drive_url")
  md5           String?
  uploadedById  String     @db.Uuid @map("uploaded_by_id")
  uploadedAt    DateTime   @default(now()) @db.Timestamptz(6) @map("uploaded_at")
  missingInDrive Boolean   @default(false) @map("missing_in_drive")

  submission    Submission @relation(fields: [workspaceId, submissionId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, submissionId])
  @@index([projectId])
  @@map("submission_files")
}

/// One routine decision per version plus at most one Dean override decision
/// (partial unique indexes in migration 0002). Append-only.
model Review {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String         @db.Uuid @map("workspace_id")
  projectId    String         @db.Uuid @map("project_id")
  submissionId String         @db.Uuid @map("submission_id")
  decision     ReviewDecision
  comment      String         @default("")
  reviewerId   String         @db.Uuid @map("reviewer_id")
  actingRole   String @map("acting_role")
  isOverride   Boolean        @default(false) @map("is_override")
  createdAt    DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")

  submission   Submission     @relation(fields: [workspaceId, submissionId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, submissionId])
  @@index([workspaceId, projectId, createdAt])
  @@index([submissionId])
  @@map("reviews")
}

model AiReview {
