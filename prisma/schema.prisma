model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lower-case (CHECK constraint in migration 0002).
  email               String     @unique
  name                String
  passwordHash        String? @map("password_hash")
  /// Google account id (`sub`) once the person has signed in with / linked Google. Unique.
  googleSub           String?    @unique @map("google_sub")
  emailVerifiedAt     DateTime?  @db.Timestamptz(6) @map("email_verified_at")
  isPlatformAdmin     Boolean    @default(false) @map("is_platform_admin")
  status              UserStatus @default(active)
  avatarUrl           String? @map("avatar_url")
  title               String     @default("")
  phone               String     @default("")
  /// bio, research interests, office hours, batch (free-form profile)
  profile             Json       @default("{}")
  notificationPrefs   Json       @default("{}") @map("notification_prefs")
  preferences         Json       @default("{}")
  supervisionDefaults Json       @default("{}") @map("supervision_defaults")
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @db.Timestamptz(6) @map("locked_until")
  passwordChangedAt   DateTime?  @db.Timestamptz(6) @map("password_changed_at")
  defaultWorkspaceId  String?    @db.Uuid @map("default_workspace_id")
  deletionRequestedAt DateTime?  @db.Timestamptz(6) @map("deletion_requested_at")
  deletionReason      String? @map("deletion_reason")
  createdAt           DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6) @map("updated_at")

  sessions            Session[]
  authTokens          AuthToken[]
  memberships         Membership[]
  driveConnection     GoogleDriveConnection?
  notifications       Notification[]
  @@map("users")
}

/// One row per signed-in device. Refresh tokens rotate inside a session.
model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid @map("user_id")
  deviceLabel   String    @default("Unknown device") @map("device_label")
  ip            String?
  userAgent     String? @map("user_agent")
  location      String    @default("")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6) @map("last_seen_at")
  revokedAt     DateTime? @db.Timestamptz(6) @map("revoked_at")
  revokedReason String? @map("revoked_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String    @db.Uuid @map("session_id")
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @default(now()) @db.Timestamptz(6) @map("issued_at")
  expiresAt    DateTime  @db.Timestamptz(6) @map("expires_at")
  /// Set exactly once, by an atomic UPDATE ... WHERE used_at IS NULL.
  usedAt       DateTime? @db.Timestamptz(6) @map("used_at")
  replacedById String?   @db.Uuid @map("replaced_by_id")

  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @db.Uuid @map("user_id")
  kind      AuthTokenKind
  tokenHash String        @unique @map("token_hash")
  payload   Json?
  expiresAt DateTime      @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime?     @db.Timestamptz(6) @map("used_at")
  createdAt DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("auth_tokens")
}

