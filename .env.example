# Copy to .env (docker compose reads it). Never commit real secrets.
NODE_ENV=development
PORT=8000

# --- Database (three roles, see docs/backend/SECURITY.md) -------------------
# The API connects as projectn_app (RLS applies). Workers and Super Admin reports use projectn_system.
DATABASE_URL=postgresql://projectn_app:app_pw@localhost:5432/projectn?connection_limit=10
DATABASE_SYSTEM_URL=postgresql://projectn_system:system_pw@localhost:5432/projectn?connection_limit=5
# Owner role: migrations only (prisma migrate deploy)
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/projectn
APP_DB_PASSWORD=app-password-change-me-1234
SYSTEM_DB_PASSWORD=system-password-change-me-1234

# --- Redis (rate limits, caches, session revocation). Required in production with >1 API instance.
REDIS_URL=redis://localhost:6379

# --- Secrets (generate: openssl rand -base64 48 / openssl rand -base64 32) --
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
TOKEN_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
TOKEN_ENCRYPTION_KEY_ID=k1
CRON_SECRET=dev-cron-secret

# --- URLs ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com
TRUST_PROXY=false

# --- Integrations: development defaults need no credentials ------------------
MAIL_DRIVER=log            # log | resend
# RESEND_API_KEY=
EMAIL_FROM="Project N <no-reply@localhost>"
DRIVE_DRIVER=fake          # fake | google
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1
AI_DRIVER=fake             # fake | gemini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Worker / ops ---------------------------------------------------------------
INLINE_WORKER=false        # true only for the free demo: runs the job loop inside the API
WORKER_CONCURRENCY=4
LOG_LEVEL=info
# METRICS_TOKEN=            # when set, /metrics requires "Authorization: Bearer <token>"
# EXPOSE_DOCS=true          # serve /api/v1/openapi.json in production
